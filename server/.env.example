# Postgres connection string (Railway provides this automatically as DATABASE_URL
# when you attach a Postgres service to this one)
DATABASE_URL=postgresql://user:password@localhost:5432/pt_app

# Secret used to sign login sessions — set this to a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# The very first trainer (admin/PT) account is created automatically on first
# boot from these two variables, if no trainer account exists yet.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Your Name
