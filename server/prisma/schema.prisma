generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TRAINER
  CLIENT
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  CANCELLED
}

enum CheckInRating {
  EASY
  JUST_RIGHT
  BRUTAL
}

// Broad movement pattern a library exercise belongs to — drives which
// animated demo is shown for it, since we don't host per-exercise video.
enum MovementPattern {
  SQUAT
  HINGE
  PUSH
  PULL
  LUNGE
  CORE
  CARRY
  CARDIO
  MOBILITY
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  notes        String? // trainer-private notes (goals, injuries, preferences) — never exposed to the client
  createdAt    DateTime @default(now())

  groupMemberships  GroupMember[]
  completions       Completion[]
  sessions          WorkoutSession[]
  createdPlans      Plan[]             @relation("PlanCreator")
  sentMessages      Message[]          @relation("MessageSender")
  pushSubscriptions PushSubscription[]
  bookingsRequested SessionBooking[]   @relation("BookingRequester")
  checkIns          WorkoutCheckIn[]
}

// A Group is the unit a plan is assigned to. Solo clients are a group of 1;
// clients who train together (pairs) are a group of 2+, sharing the same
// assigned plan while each member's completions are tracked separately.
model Group {
  id          String    @id @default(cuid())
  name        String
  coachNote   String? // short message from the trainer shown on this client's home screen
  coachNoteAt DateTime?
  createdAt   DateTime  @default(now())

  members  GroupMember[]
  plans    Plan[]
  messages Message[]
  bookings SessionBooking[]
}

model GroupMember {
  id      String @id @default(cuid())
  groupId String
  userId  String

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Plan {
  id          String    @id @default(cuid())
  groupId     String
  title       String
  notes       String?
  startDate   DateTime?
  expiresAt   DateTime?
  priceLabel  String? // free-text, e.g. "£120 / 8 weeks" — displayed to the client too
  archived    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  createdById String

  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User   @relation("PlanCreator", fields: [createdById], references: [id])
  weeks     Week[]
}

model Week {
  id     String  @id @default(cuid())
  planId String
  index  Int
  label  String?

  plan Plan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  days Day[]
}

model Day {
  id     String @id @default(cuid())
  weekId String
  index  Int
  label  String

  week      Week             @relation(fields: [weekId], references: [id], onDelete: Cascade)
  exercises Exercise[]
  sessions  WorkoutSession[]
}

model Exercise {
  id            String  @id @default(cuid())
  dayId         String
  index         Int
  name          String
  sets          Int?
  reps          String?
  weight        String?
  restSeconds   Int?
  notes         String?
  libraryItemId String?

  day         Day                  @relation(fields: [dayId], references: [id], onDelete: Cascade)
  libraryItem ExerciseLibraryItem? @relation(fields: [libraryItemId], references: [id])
  completions Completion[]
}

// A small curated catalog the trainer can pick from when building a plan.
// Gives every exercise a consistent movement-pattern animation and a form cue.
model ExerciseLibraryItem {
  id          String          @id @default(cuid())
  name        String          @unique
  pattern     MovementPattern
  muscles     String
  cue         String
  defaultSets Int?
  defaultReps String?
  defaultRest Int?

  exercises Exercise[]
}

model Completion {
  id           String   @id @default(cuid())
  exerciseId   String
  userId       String
  completedAt  DateTime @default(now())
  actualSets   Int?
  actualReps   String?
  actualWeight String?
  notes        String?

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, userId])
}

model WorkoutSession {
  id              String    @id @default(cuid())
  dayId           String
  userId          String
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationSeconds Int?

  day  Day  @relation(fields: [dayId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  checkIn WorkoutCheckIn?
}

// A client's "how did that feel?" response after finishing a session —
// paired 1:1 with the WorkoutSession. A note here is also dropped into the
// group's chat thread so the client can ask a question if they struggled.
model WorkoutCheckIn {
  id        String        @id @default(cuid())
  sessionId String        @unique
  userId    String
  rating    CheckInRating
  note      String?
  createdAt DateTime      @default(now())

  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One chat thread per group (a solo client or a pair) between its member(s)
// and the trainer.
model Message {
  id        String    @id @default(cuid())
  groupId   String
  senderId  String
  body      String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  group  Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender User  @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
}

// A client's request to book a 1:1 session with the trainer. Simple
// request/respond flow — no availability calendar yet.
model SessionBooking {
  id            String        @id @default(cuid())
  groupId       String
  requestedById String
  startTime     DateTime
  status        BookingStatus @default(REQUESTED)
  clientNote    String?
  trainerNote   String?
  createdAt     DateTime      @default(now())
  respondedAt   DateTime?

  group       Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("BookingRequester", fields: [requestedById], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
